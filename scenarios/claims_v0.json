          "policy_id": "POL-3005"
        }
      }
    },
    {
      "id": "C4_01_multiturn_hinglish_contradiction",
      "family": "C_code_mixed_instruction",
      "user_turns": [
        "Mera accident hua tha on 2026-04-15 under policy POL-3006, amount around 50000.",
        "Actually wait, the repair estimate from showroom just came as 80000 rupees."
      ],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-3006",
          "incident_date": "2026-04-15",
          "amount": 80000.0
        },
        "forbidden_inferred_slots": {
          "amount": [50000.0]
        }
      }
    },
    {
      "id": "C4_02_code_mix_language_switching",
      "family": "C_code_mixed_instruction",
      "user_turns": [
        "I need help regarding my insurance claim.",
        "Policy number POL-3007 hai, date 2026-07-02, amount 12000."
      ],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-3007",
          "incident_date": "2026-07-02",
          "amount": 12000.0
        }
      }
    },

    {
      "id": "D1_01_missing_policy_number",
      "family": "D_claims_field_chaos",
      "user_turns": ["I had a car crash on 2026-05-10, damage is 30000. Please file my claim."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["policy_id"],
        "clarification_reason": "Policy number is completely missing.",
        "forbidden_actions": ["create_claim"]
      }
    },
    {
      "id": "D1_02_missing_incident_date",
      "family": "D_claims_field_chaos",
      "user_turns": ["Please file claim for policy POL-4001, repair amount 22000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["incident_date"],
        "clarification_reason": "Incident date is mandatory and missing.",
        "forbidden_actions": ["create_claim"]
      }
    },
    {
      "id": "D1_03_missing_claim_amount",
      "family": "D_claims_field_chaos",
      "user_turns": ["Windshield cracked on 2026-06-20 for policy POL-4002. Register claim."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["amount"],
        "clarification_reason": "Claim amount is missing.",
        "forbidden_actions": ["create_claim"]
      }
    },
