      }
    },
    {
      "id": "E3_01_malformed_args_argument_corruption",
      "family": "E_recovery_and_loop_pressure",
      "user_turns": ["File claim POL-5004 on 2026-06-15 for 32000."],
      "chaos_overlay": {
        "inject_malformed_args": true,
        "corrupt_arg_keys": true,
        "target_tools": ["create_claim"],
        "trigger_on_call_count": 1
      },
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "recovery_expectation": "Agent catches parameter mismatch and does not enter infinite recursion."
      }
    },
    {
      "id": "E3_02_multiple_tool_failures_then_graceful_stop",
      "family": "E_recovery_and_loop_pressure",
      "user_turns": ["Check status of claim CLM-9999."],
      "chaos_overlay": {
        "inject_tool_error": true,
        "tool_error_message": "Network Gateway Timeout",
        "target_tools": ["get_claim_status"]
      },
      "behavior_contract": {
        "expected_action": "execute",
