          "claim_id": "CLM-9912"
        }
      }
    },
    {
      "id": "C1_02_hinglish_claim_intake",
      "family": "C_code_mixed_instruction",
      "user_turns": ["Bhai kal meri gadi thuk gayi, policy number POL-3002 hai. Incident date 2026-05-19, nuksan 35000 hua."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-3002",
          "incident_date": "2026-05-19",
          "amount": 35000.0
        }
      }
    },
    {
      "id": "C2_01_tanglish_accident_update",
      "family": "C_code_mixed_instruction",
      "user_turns": ["Ennoda car accident aaiduchu on 2026-06-12. Policy POL-3003, repair cost 40000 aagum."],
