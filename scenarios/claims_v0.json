        "forbidden_inferred_slots": {
          "amount": [4.5, 45000.0]
        }
      }
    },
    {
      "id": "B2_01_devanagari_numerals",
      "family": "B_number_amount_formats",
      "user_turns": ["Policy POL-2004, date 2026-05-11, total loss ₹५००००."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-2004",
          "incident_date": "2026-05-11",
          "amount": 50000.0
        }
      }
    },
    {
      "id": "B2_02_mixed_rupee_words_and_number",
      "family": "B_number_amount_formats",
      "user_turns": ["Policy POL-2005, date 2026-06-01, damage estimate is Rs 75k."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-2005",
          "incident_date": "2026-06-01",
          "amount": 75000.0
        },
        "forbidden_inferred_slots": {
          "amount": [75.0]
        }
      }
    },
    {
      "id": "B3_01_indian_comma_system",
      "family": "B_number_amount_formats",
      "user_turns": ["Accident claim POL-2006 on 2026-01-20 for amount 1,50,000."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-2006",
          "incident_date": "2026-01-20",
          "amount": 150000.0
        },
        "forbidden_inferred_slots": {
          "amount": [1.5, 150.0]
        }
      }
    },
    {
      "id": "B3_02_european_decimal_confusion",
      "family": "B_number_amount_formats",
      "user_turns": ["Policy POL-2007 on 2026-04-18, medical reimbursement 15.000,00."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["amount"],
        "clarification_reason": "Ambiguous decimal vs thousand separator in European formatting '15.000,00'."
      }
    },
    {
      "id": "B3_03_negative_amount_claim",
      "family": "B_number_amount_formats",
      "user_turns": ["Policy POL-2008 on 2026-03-20, claim refund amount -5000."],
      "behavior_contract": {
        "expected_action": "reject",
        "rejection_reason": "Claim amount must be strictly positive."
      }
    },

    {
      "id": "C1_01_hinglish_status_check",
      "family": "C_code_mixed_instruction",
      "user_turns": ["Mera claim status check kardo na for policy POL-3001, claim id CLM-9912."],
      "behavior_contract": {
        "expected_action": "execute",
