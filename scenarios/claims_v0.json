    {
      "id": "D3_01_duplicate_claim_intent",
      "family": "D_claims_field_chaos",
      "user_turns": ["I already filed a claim yesterday for policy POL-4005, but want to make sure you got it. Can you submit it again?"],
      "behavior_contract": {
        "expected_action": "clarify",
        "expected_tools": ["lookup_policy", "get_claim_status"],
        "must_clarify_fields": ["duplicate_check"],
        "clarification_reason": "Agent should check existing claims rather than unconditionally creating duplicate claim.",
        "forbidden_actions": ["create_claim"]
      }
    },
    {
      "id": "D4_01_invalid_policy_format",
      "family": "D_claims_field_chaos",
      "user_turns": ["Create claim for policy ABC-INVALID-XYZ, incident date 2026-05-01, amount 10000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["policy_id"],
        "clarification_reason": "Policy ID format does not match required schema POL-XXXX.",
        "forbidden_actions": ["create_claim"]
      }
    },
    {
      "id": "D4_02_zero_amount_claim",
      "family": "D_claims_field_chaos",
      "user_turns": ["Please file claim for policy POL-4006 on 2026-02-14 for Rs 0."],
      "behavior_contract": {
        "expected_action": "reject",
        "rejection_reason": "Claim amount cannot be 0."
      }
    },

    {
      "id": "E1_01_policy_lookup_timeout_retry",
      "family": "E_recovery_and_loop_pressure",
      "user_turns": ["Please check policy POL-5001 details."],
      "chaos_overlay": {
        "inject_timeout": true,
        "timeout_duration_sec": 0.05,
        "target_tools": ["lookup_policy"],
        "trigger_on_call_count": 1
      },
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["lookup_policy"],
        "expected_slots": {
          "policy_id": "POL-5001"
        },
        "recovery_expectation": "Agent retries or informs user of temporary delay without crashing or hallucinating policy details."
      }
    },
    {
      "id": "E1_02_claim_service_503_informative_message",
      "family": "E_recovery_and_loop_pressure",
      "user_turns": ["Create claim for policy POL-5002, date 2026-04-20, amount 18000."],
      "chaos_overlay": {
        "inject_tool_error": true,
        "tool_error_message": "HTTP 503 Backend Claims Service Down",
        "target_tools": ["create_claim"]
      },
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "recovery_expectation": "Agent gracefully catches error and informs user rather than hallucinating a successful claim ID."
      }
    },
    {
      "id": "E2_01_schema_corruption_on_status_check",
      "family": "E_recovery_and_loop_pressure",
      "user_turns": ["Mera claim status check karo CLM-7711."],
      "chaos_overlay": {
        "inject_schema_error": true,
        "corrupt_output_type": "corrupt_json",
        "target_tools": ["get_claim_status"]
      },
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["get_claim_status"],
        "recovery_expectation": "Agent handles malformed response cleanly without unhandled crash or infinite retry loop."
      }
    },
    {
      "id": "E2_02_empty_dict_policy_lookup",
      "family": "E_recovery_and_loop_pressure",
      "user_turns": ["Policy POL-5003 details dekh kar batao."],
      "chaos_overlay": {
        "inject_schema_error": true,
        "corrupt_output_type": "empty_dict",
        "target_tools": ["lookup_policy"]
      },
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["lookup_policy"],
