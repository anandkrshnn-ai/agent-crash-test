{
  "pack_id": "claims_v0_indic_chaos",
  "version": "0.1.0",
  "description": "Insurance claims intake scenario pack testing Indic date formats, Indian numbering units, code-mixed Hinglish/Tanglish instructions, form/text contradictions, and recovery.",
  "target_domain": "insurance_claims",
  "scenarios": [
    {
      "id": "A1_01_ddmm_ambiguous_slash",
      "family": "A_date_time_ambiguity",
      "user_turns": ["I had a bike accident on 03/04/2026. Please file a claim for policy POL-1001 for amount 15000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["incident_date"],
        "clarification_reason": "Date 03/04/2026 is ambiguous (3rd April vs 4th March) in absence of explicit locale agreement.",
        "allowed_inferred_slots": {
          "policy_id": "POL-1001",
          "amount": 15000
        },
        "forbidden_inferred_slots": {
          "incident_date": ["2026-03-04"]
        }
      }
    },
    {
      "id": "A1_02_ddmm_unambiguous_high_day",
      "family": "A_date_time_ambiguity",
      "user_turns": ["Accident occurred on 24/05/2026. Policy POL-1002, estimated repair cost Rs 25000."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-1002",
          "incident_date": "2026-05-24",
          "amount": 25000
        },
        "forbidden_inferred_slots": {
          "incident_date": ["2026-24-05", "null"]
        }
      }
    },
    {
      "id": "A2_01_mixed_date_across_turns",
      "family": "A_date_time_ambiguity",
      "user_turns": [
        "Need to register claim for policy POL-1003.",
        "Incident happened on 5th Aug 2026, hospital bill is 45000."
      ],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-1003",
          "incident_date": "2026-08-05",
          "amount": 45000
        }
      }
    },
    {
      "id": "A2_02_short_year_hyphen_format",
      "family": "A_date_time_ambiguity",
      "user_turns": ["Policy POL-1004, water leakage damage on 12-07-26, damage estimate 60000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["incident_date"],
        "clarification_reason": "Date 12-07-26 has two-digit year and ambiguous month/day format."
      }
    },
    {
      "id": "A3_01_relative_date_parso",
      "family": "A_date_time_ambiguity",
      "user_turns": ["Parso mera car accident hua tha. Policy id POL-1005, repair bill 18000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["incident_date"],
        "clarification_reason": "Relative time 'parso' (day before yesterday / day after tomorrow) requires anchored reference time verification."
      }
    },
    {
      "id": "A3_02_relative_date_last_monday",
      "family": "A_date_time_ambiguity",
      "user_turns": ["Water damage on last Monday for policy POL-1006. Claim amount is 12000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["incident_date"],
        "clarification_reason": "Relative calendar reference requires explicit calendar date confirmation."
      }
    },
    {
      "id": "A3_03_kal_shaam_hinglish",
      "family": "A_date_time_ambiguity",
      "user_turns": ["Kal shaam ko theft hua tha at my shop. Policy POL-1007. Loss around 85000."],
      "behavior_contract": {
        "expected_action": "clarify",
        "must_clarify_fields": ["incident_date"],
        "clarification_reason": "Hinglish relative term 'kal shaam' needs date confirmation before filing."
      }
    },
    {
      "id": "A4_01_future_incident_date",
      "family": "A_date_time_ambiguity",
      "user_turns": ["Filing claim for accident on 30/12/2029 under policy POL-1008 for 10000."],
      "behavior_contract": {
        "expected_action": "reject",
        "rejection_reason": "Incident date cannot be in the future."
      }
    },

    {
      "id": "B1_01_amount_in_lakhs_decimal",
      "family": "B_number_amount_formats",
      "user_turns": ["Car collision claim for policy POL-2001. Date 2026-04-10, repair quote is 2.5 lakh rupees."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-2001",
          "incident_date": "2026-04-10",
          "amount": 250000.0
        },
        "forbidden_inferred_slots": {
          "amount": [2.5, 25000.0, 2500.0]
        }
      }
    },
    {
      "id": "B1_02_amount_in_crores_symbol",
      "family": "B_number_amount_formats",
      "user_turns": ["Commercial warehouse fire on 2026-03-15 for policy POL-2002. Total loss is ₹1.2 Cr."],
      "behavior_contract": {
        "expected_action": "execute",
