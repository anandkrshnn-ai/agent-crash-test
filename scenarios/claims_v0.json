          "policy_id": "POL-3004"
        }
      }
    },
    {
      "id": "C3_02_tamil_script_name_policy_id",
      "family": "C_code_mixed_instruction",
      "user_turns": ["பெயர்: கார்த்திக், policy POL-3005 details thevai."],
      "behavior_contract": {
