          "policy_id": "POL-2002",
          "incident_date": "2026-03-15",
          "amount": 12000000.0
        },
        "forbidden_inferred_slots": {
          "amount": [1.2, 120000.0, 1200000.0]
        }
      }
    },
    {
      "id": "B1_03_amount_in_words_lakh",
      "family": "B_number_amount_formats",
      "user_turns": ["Policy POL-2003, date 2026-02-18, hospital expense of four lakh fifty thousand only."],
      "behavior_contract": {
        "expected_action": "execute",
        "expected_tools": ["create_claim"],
        "expected_slots": {
          "policy_id": "POL-2003",
          "incident_date": "2026-02-18",
